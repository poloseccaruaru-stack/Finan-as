rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Fields: name, email, role, createdAt
    //
    // Collection: students
    // Fields: name, birthDate, guardians, emergencyContact, history, classId, createdAt
    //
    // Collection: teachers
    // Fields: name, email, subjects, classIds, createdAt
    //
    // Collection: classes
    // Fields: name, year, teacherId, createdAt
    //
    // Collection: attendance
    // Fields: classId, date, presentStudentIds, absentStudentIds, createdAt
    //
    // Collection: projects
    // Fields: title, description, startDate, endDate, teacherIds, studentIds, createdAt
    //
    // Collection: transactions
    // Fields: description, amount, type, category, date, status, createdAt
    //
    // Collection: regimento
    // Fields: title, content, order, createdAt
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "poloseccaruaru@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidString(field, maxLen) {
      return request.resource.data[field] is string && request.resource.data[field].size() <= maxLen;
    }

    function isValidNumber(field) {
      return request.resource.data[field] is number;
    }

    // Rules for each collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // For now, allow all authenticated users
    }

    match /teachers/{teacherId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /transactions/{transactionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /regimento/{regId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /justificationOptions/{optId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /reports/{reportId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /budgets/{budgetId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /estimated_expenses/{expenseId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /calendarEvents/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /planning/{planningId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /student_reports/{reportId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /teacher_reports/{reportId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /meetings/{meetingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /general_calendars/{calId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /organogram/{entryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /test/{docId} {
      allow read: if isAuthenticated();
    }
  }
}
