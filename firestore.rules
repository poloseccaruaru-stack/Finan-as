rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        ((exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coordinator')) ||
         (request.auth.token.email == "poloseccaruaru@gmail.com" && request.auth.token.email_verified == true));
    }

    function isTeacher() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Validation Helpers
    function isValidAbsenceResolution(data) {
      return data.studentId is string && data.studentId.size() <= 128 &&
             data.note is string && data.note.size() <= 5000 &&
             data.date is string && data.date.size() <= 20 &&
             data.consecutiveAbsences is number &&
             (data.teacherId == request.auth.uid || isAdmin());
    }

    // Rules for each collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isTeacher();
    }

    match /teachers/{teacherId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isTeacher();
    }

    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isTeacher();
    }

    match /transactions/{transactionId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /regimento/{regId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /absenceResolutions/{resId} {
      allow read: if isAdmin() || isTeacher();
      allow create: if isAuthenticated() && isValidAbsenceResolution(incoming());
      allow update: if (isAdmin() || (isAuthenticated() && existing().teacherId == request.auth.uid)) && isValidAbsenceResolution(incoming());
      allow delete: if isAdmin();
    }

    match /preDefinedResolutions/{resId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /enrollments/{enrollId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /ai_actions/{actionId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /calendarEvents/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /planning/{planningId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isTeacher();
    }

    match /student_reports/{reportId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isTeacher();
    }

    match /teacher_reports/{reportId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /meetings/{meetingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /general_calendars/{calId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /organogram/{entryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /test/{docId} {
      allow read: if isAuthenticated();
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
