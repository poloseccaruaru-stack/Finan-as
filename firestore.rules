rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        ((request.auth.token.email == "poloseccaruaru@gmail.com" && request.auth.token.email_verified == true) ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coordinator')));
    }

    function hasTabAccess(tab, level) {
      return isAdmin() || 
             (isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
              (
                (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('permissions', null) != null && 
                 (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions.get(tab, 0) >= level || 
                  (level == 1 && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions.get('reports', 0) >= 1 && ['academic', 'projects', 'finance', 'planning', 'attendance', 'students', 'classes'].hasAny([tab])))) ||
                (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('permissions', null) == null && 
                 (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('allowedTabs', []).hasAny([tab]) || 
                  (level == 1 && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('allowedTabs', []).hasAny(['reports']))))
              )
             );
    }

    function isTeacher() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    function isTeacherOfClass(classId) {
      return isTeacher() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('classIds', []).hasAny([classId]);
    }

    function isTeacherOfStudent(studentData) {
      return isTeacher() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('classIds', []).hasAny([studentData.classId]);
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Rules for each collection
    match /users/{userId} {
      allow read: if isAuthenticated() || (request.auth == null && resource.data.login != null && resource.data.password != null);
      allow write: if isOwner(userId) || isAdmin();
    }

    match /user_configs/{configId} {
      allow read, write: if isAuthenticated() && (configId == "dashboard_" + request.auth.uid || isAdmin());
    }

    match /students/{studentId} {
      allow read: if hasTabAccess('academic', 1) || isTeacherOfStudent(resource.data);
      allow write: if hasTabAccess('academic', 2) || isTeacherOfStudent(request.resource.data);
    }

    match /teachers/{teacherId} {
      allow read: if isAdmin() || isCoordinator();
      allow write: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if hasTabAccess('academic', 1) || isTeacherOfClass(classId);
      allow write: if isAdmin() || isCoordinator();
    }

    match /attendance/{attendanceId} {
      allow read: if hasTabAccess('academic', 1) || isTeacherOfClass(resource.data.classId);
      allow write: if hasTabAccess('academic', 2) || isTeacherOfClass(request.resource.data.classId);
    }

    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isCoordinator();
    }

    match /transactions/{transactionId} {
      allow read: if isAdmin() || isCoordinator();
      allow write: if isAdmin() || isCoordinator();
    }

    match /budgets/{budgetId} {
      allow read: if isAdmin() || isCoordinator();
      allow write: if isAdmin() || isCoordinator();
    }

    match /estimated_expenses/{expId} {
      allow read: if isAdmin() || isCoordinator();
      allow write: if isAdmin() || isCoordinator();
    }

    match /regimento/{regId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isCoordinator();
    }

    match /comunicados/{comId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isCoordinator();
    }

    match /documentos/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isCoordinator();
    }

    match /absenceResolutions/{resId} {
      allow read: if hasTabAccess('academic', 1) || isTeacher();
      allow create: if isAuthenticated() && incoming().teacherId == request.auth.uid;
      allow update: if isAdmin() || isCoordinator() || (isAuthenticated() && existing().teacherId == request.auth.uid);
      allow delete: if isAdmin() || isCoordinator();
    }

    match /preDefinedResolutions/{resId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isCoordinator();
    }

    match /justificationOptions/{optId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isCoordinator();
    }

    match /enrollments/{enrollId} {
      allow read: if isAdmin() || isCoordinator();
      allow write: if isAdmin() || isCoordinator();
    }

    match /ai_actions/{actionId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /calendarEvents/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isCoordinator();
    }

    match /planning/{planningId} {
      allow read: if hasTabAccess('academic', 1) || isTeacherOfClass(resource.data.classId);
      allow write: if hasTabAccess('academic', 2) || isTeacherOfClass(request.resource.data.classId);
    }

    match /student_reports/{reportId} {
      allow read: if isAdmin() || isCoordinator() || (isTeacher() && resource.data.get('teacherId', '') == request.auth.uid);
      allow write: if isAdmin() || isCoordinator() || (isTeacher() && request.resource.data.get('teacherId', '') == request.auth.uid);
    }

    match /teacher_reports/{reportId} {
      allow read: if isAdmin() || isCoordinator();
      allow write: if isAdmin() || isCoordinator();
    }

    match /manual_reports/{reportId} {
      allow read: if isAdmin() || isCoordinator();
      allow write: if isAdmin() || isCoordinator();
    }

    match /meetings/{meetingId} {
      allow read: if isAdmin() || isCoordinator();
      allow write: if isAdmin() || isCoordinator();
    }

    match /general_calendars/{calId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /organogram/{entryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /test/{docId} {
      allow read: if isAuthenticated();
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
