{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Student profile with personal and academic data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "birthDate": { "type": "string", "format": "date" },
        "guardians": { "type": "string" },
        "emergencyContact": { "type": "string" },
        "history": { "type": "string" },
        "photoURL": { "type": "string" },
        "churchStatus": { "type": "string", "enum": ["membro", "congregado", "visitante", "outros"] },
        "classId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "birthDate"]
    },
    "Teacher": {
      "title": "Teacher",
      "description": "Teacher profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "contact": { "type": "string" },
        "subjects": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name"]
    },
    "Class": {
      "title": "Class",
      "description": "A school class",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "year": { "type": "string" },
        "teacherId": { "type": "string" },
        "studentIds": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "year"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Daily attendance record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "classId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "presentStudentIds": { "type": "array", "items": { "type": "string" } },
        "absentStudentIds": { "type": "array", "items": { "type": "string" } },
        "visitorCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["classId", "date"]
    },
    "Project": {
      "title": "Project",
      "description": "School project",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "teacherIds": { "type": "array", "items": { "type": "string" } },
        "studentIds": { "type": "array", "items": { "type": "string" } },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "startDate"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "category": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["pending", "paid"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["description", "amount", "type", "date", "status"]
    },
    "Regimento": {
      "title": "Regimento",
      "description": "School rules and regulations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["title", "content"]
    },
    "CalendarEvent": {
      "title": "CalendarEvent",
      "description": "School calendar event",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "type": { "type": "string", "enum": ["holiday", "meeting", "event", "other"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "date", "type"]
    },
    "Meeting": {
      "title": "Meeting",
      "description": "Meeting minutes and records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["ADMINISTRATIVA", "PEDAGÓGICA", "PAIS", "ALUNOS", "GERAL", "OUTRAS"] },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "participants": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "title", "content", "date"]
    },
    "GeneralCalendar": {
      "title": "GeneralCalendar",
      "description": "General text-based calendar",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content"]
    },
    "SavedAISearch": {
      "title": "SavedAISearch",
      "description": "Conteúdos de Pesquisa Salvas no Assistente de IA",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "comments": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "date"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": "Teacher", "description": "System users and their roles" },
    "/students/{studentId}": { "schema": "Student", "description": "Students" },
    "/teachers/{teacherId}": { "schema": "Teacher", "description": "Teachers" },
    "/classes/{classId}": { "schema": "Class", "description": "Classes" },
    "/attendance/{attendanceId}": { "schema": "Attendance", "description": "Attendance records" },
    "/projects/{projectId}": { "schema": "Project", "description": "Projects" },
    "/transactions/{transactionId}": { "schema": "Transaction", "description": "Financial records" },
    "/regimento/{regimentoId}": { "schema": "Regimento", "description": "School regulations" },
    "/calendar/{eventId}": { "schema": "CalendarEvent", "description": "Calendar events" },
    "/meetings/{meetingId}": { "schema": "Meeting", "description": "Meeting minutes" },
    "/general_calendars/{calendarId}": { "schema": "GeneralCalendar", "description": "General calendars" },
    "/profiles/{profileId}": { "schema": "AccessProfile", "description": "Access profiles and permissions" },
    "/justificationOptions/{optId}": { "schema": "JustificationOption", "description": "Options for absence justifications" },
    "/comunicados/{comId}": { "schema": "Comunicado", "description": "School announcements" },
    "/documentos/{docId}": { "schema": "Documento", "description": "General documents" },
    "/budgets/{budgetId}": { "schema": "Budget", "description": "Monthly budgets" },
    "/estimated_expenses/{expenseId}": { "schema": "EstimatedExpense", "description": "Estimated monthly expenses" },
    "/manual_reports/{reportId}": { "schema": "ManualReport", "description": "Manually created custom reports" },
    "/saved_ai_searches/{searchId}": { "schema": "SavedAISearch", "description": "Conteúdos de Pesquisa Salvas no Assistente de IA" }
  }
}
